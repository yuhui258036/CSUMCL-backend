# Source-only repository: explicitly allow reviewed source and examples.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/后台文案清单.md
!/SECURITY.md
!/*.cs
!/*.csproj
!/*.js
!/admin.css
!/admin-logo.png
!/appsettings.example.json
!/deploy/
/deploy/*
!/deploy/install.sh
!/deploy/pcl-cmu.service
!/tests/
/tests/*
!/tests/PclCmu.Admin.Tests/
/tests/PclCmu.Admin.Tests/*
!/tests/PclCmu.Admin.Tests/Program.cs
!/tests/PclCmu.Admin.Tests/*.cs
!/tests/PclCmu.Admin.Tests/*.cjs
!/tests/PclCmu.Admin.Tests/*.sh
!/tests/PclCmu.Admin.Tests/PclCmu.Admin.Tests.csproj

# Defense in depth: never version credentials, private material or runtime data.
**/bin/
**/obj/
**/keys/
**/certs/
**/data/
**/wwwroot/
**/publish*/
**/logs/
**/backups/
**/.vs/
**/.env
**/.env.*
**/admin.env
**/*credentials*
**/auth.dat
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.p8
**/*.jks
**/*.keystore
**/*.user
**/id_rsa*
**/id_ed25519*
**/appsettings.json
**/appsettings.*.json
!/appsettings.example.json
