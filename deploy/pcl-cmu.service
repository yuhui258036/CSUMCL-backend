[Unit]
Description=PCL-CMU admin backend (public resource site + loopback admin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pcl-cmu/app
ExecStart=/opt/dotnet/dotnet /opt/pcl-cmu/app/PclCmu.Admin.dll
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077
RuntimeDirectory=pcl-cmu
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/pcl-cmu
EnvironmentFile=/opt/pcl-cmu/admin.env

# To bind the privileged port 443 without running the whole process as root,
# create a dedicated user in install.sh and uncomment the lines below.
#User=pclcmu
#Group=pclcmu
#AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/pcl-cmu/data /opt/pcl-cmu/wwwroot
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
